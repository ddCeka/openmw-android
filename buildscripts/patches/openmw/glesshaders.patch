diff --git a/files/shaders/gles/compatibility/groundcover.frag b/files/shaders/gles/compatibility/groundcover.frag
index e69de29bb2..f6f7d100c5 100755
--- a/files/shaders/gles/compatibility/groundcover.frag
+++ b/files/shaders/gles/compatibility/groundcover.frag
@@ -0,0 +1,123 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+uniform mat4 osg_ModelViewMatrix;
+uniform mat3 osg_NormalMatrix;
+layout(location = 0) out vec4 Color0;
+layout(location = 1) out vec4 Color1;
+#define texture2D texture
+#define texture2DArray texture
+#define textureSize2D textureSize
+#define varying in
+#define shadow2DProj custom_shadow2DProj
+vec4 custom_shadow2DProj(sampler2DShadow sampler, vec4 uv) { return vec4(textureProj(sampler, uv)); }
+//HEADER_END
+
+
+#if @useGPUShader4
+    //#extension GL_EXT_gpu_shader4: require
+#endif
+
+#include "lib/core/fragment.h.glsl"
+
+#define GROUNDCOVER
+
+#if @diffuseMap
+uniform sampler2D diffuseMap;
+varying vec2 diffuseMapUV;
+#endif
+
+#if @normalMap
+uniform sampler2D normalMap;
+varying vec2 normalMapUV;
+#endif
+
+// Other shaders respect forcePPL, but legacy groundcover mods were designed to work with vertex lighting.
+// They may do not look as intended with per-pixel lighting, so ignore this setting for now.
+#define PER_PIXEL_LIGHTING @normalMap
+
+varying float euclideanDepth;
+varying float linearDepth;
+//uniform vec2 screenRes;
+//uniform float near;
+uniform float far;
+uniform float alphaRef;
+
+#if PER_PIXEL_LIGHTING
+#include "lib/light/clamp.glsl"
+#else
+centroid varying vec3 shadedLighting;
+centroid varying vec3 passLighting;
+#endif
+
+varying vec3 passNormal;
+varying vec3 passViewPos;
+
+#include "shadows_fragment.glsl"
+#include "lib/material/alpha.glsl"
+#include "fog.glsl"
+#include "compatibility/normals.glsl"
+
+centroid varying vec4 passColor;
+
+void main()
+{
+#if @useClipDistanceFallback
+    applyClipPlanes();
+#endif
+
+    Material material = getMaterial();
+
+#if @diffuseMap
+    Color0 = texture2D(diffuseMap, diffuseMapUV);
+#else
+    Color0 = vec4(1.0);
+#endif
+
+    if (euclideanDepth > @groundcoverFadeStart)
+        Color0.a *= 1.0-smoothstep(@groundcoverFadeStart, @groundcoverFadeEnd, euclideanDepth);
+
+    Color0.a = alphaTest(Color0.a, alphaRef);
+
+#if @normalMap
+    vec4 normalTex = texture2D(normalMap, normalMapUV);
+    vec3 normal = normalTex.xyz * 2.0 - 1.0;
+#if @reconstructNormalZ
+    normal.z = sqrt(1.0 - dot(normal.xy, normal.xy));
+#endif
+    vec3 viewNormal = normalToView(normal);
+#else
+    vec3 viewNormal = normalToView(normalize(passNormal));
+#endif
+
+    float shadowing = unshadowedLightRatio(linearDepth);
+
+    vec3 lighting;
+#if !PER_PIXEL_LIGHTING
+    lighting = mix(shadedLighting, passLighting, shadowing);
+#else
+    vec3 diffuseLight, ambientLight, specularLight;
+    doLighting(gl_FragCoord.xy, passViewPos, viewNormal, material.shininess, shadowing, diffuseLight, ambientLight, specularLight);
+    lighting = diffuseLight + ambientLight;
+    clampLighting(lighting);
+#endif
+
+    Color0.xyz *= lighting;
+    Color0 = applyFogAtDist(Color0, passViewPos, euclideanDepth, linearDepth, near, far);
+
+#if !@disableNormals
+    Color1.xyz = viewNormal * 0.5 + 0.5;
+#endif
+
+    applyShadowDebugOverlay();
+}
+
