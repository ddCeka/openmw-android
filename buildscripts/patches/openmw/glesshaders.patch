+    applyClipPlanes();
+#endif
+
+    float alpha = texture2D(diffuseMap, diffuseMapUV).a * alphaPassthrough;
+
+    const float alphaRef = 0.499;
+
+    if (alpha < alphaRef)
+        discard;
+
+    // DO NOT write to color!
