+    }
+    else
+    {
+        gl_Position = modelToClip( vec4(osg_Vertex.xyz * scale + trans,1));
+
+        vertexNormal = useNormalAsColor ? vec3(1., 1., 1.) : osg_Normal.xyz;
+        vec3 colorOut = useNormalAsColor? osg_Normal.xyz : color;
+        passColor = vec4(colorOut, 1.);
+    }
+}
