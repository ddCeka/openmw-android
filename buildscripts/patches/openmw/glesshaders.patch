+{
+    gl_Position = modelToClip(osg_Vertex);
+    passColor = osg_Color;
+
+    if (pass == PASS_CLOUDS)
+        diffuseMapUV = (texMat0 * osg_MultiTexCoord0).xy;
+    else
+        diffuseMapUV = osg_MultiTexCoord0.xy;
