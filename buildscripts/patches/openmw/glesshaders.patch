diff --git a/files/shaders/gles/compatibility/ripples_simulate.frag b/files/shaders/gles/compatibility/ripples_simulate.frag
index e69de29bb2..0616b78fb0 100755
--- a/files/shaders/gles/compatibility/ripples_simulate.frag
+++ b/files/shaders/gles/compatibility/ripples_simulate.frag
@@ -0,0 +1,55 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+uniform mat4 osg_ModelViewMatrix;
+uniform mat3 osg_NormalMatrix;
+layout(location = 0) out vec4 Color0;
+layout(location = 1) out vec4 Color1;
+#define texture2D texture
+#define texture2DArray texture
+#define textureSize2D textureSize
+#define varying in
+#define shadow2DProj custom_shadow2DProj
+vec4 custom_shadow2DProj(sampler2DShadow sampler, vec4 uv) { return vec4(textureProj(sampler, uv)); }
+//HEADER_END
+
+
+uniform sampler2D imageIn;
+
+#include "lib/water/ripples.glsl"
+
+void main()
+{
+    vec2 uv = gl_FragCoord.xy / @rippleMapSize;
+
+    float pixelSize = 1.0 / @rippleMapSize;
+
+    float oneOffset = pixelSize;
+    float oneAndHalfOffset = 1.5 * pixelSize;
+
+    vec4 n = vec4(
+        texture2D(imageIn, uv + vec2(oneOffset, 0.0)).r,
+        texture2D(imageIn, uv + vec2(-oneOffset, 0.0)).r,
+        texture2D(imageIn, uv + vec2(0.0, oneOffset)).r,
+        texture2D(imageIn, uv + vec2(0.0, -oneOffset)).r
+    );
+
+    vec4 n2 = vec4(
+        texture2D(imageIn, uv + vec2(oneAndHalfOffset, 0.0)).r,
+        texture2D(imageIn, uv + vec2(-oneAndHalfOffset, 0.0)).r,
+        texture2D(imageIn, uv + vec2(0.0, oneAndHalfOffset)).r,
+        texture2D(imageIn, uv + vec2(0.0, -oneAndHalfOffset)).r
+    );
+
+    vec4 color = texture2D(imageIn, uv);
+
+    Color0 = applySprings(color, n, n2);
+}
