diff --git a/files/shaders/gles/core/lighting/cluster.comp b/files/shaders/gles/core/lighting/cluster.comp
index e69de29bb2..90ce3e60a9 100755
--- a/files/shaders/gles/core/lighting/cluster.comp
+++ b/files/shaders/gles/core/lighting/cluster.comp
@@ -0,0 +1,63 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+//HEADER_END
+
+
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+
+#include "lib/light/bindings.glsl"
+
+uniform float near;
+uniform mat4 inverseProjectionMatrix;
+uniform vec3 gridSize;
+uniform vec2 screenRes;
+uniform float clusterFar;
+
+vec3 lineIntersectionWithZPlane(vec3 startPoint, vec3 endPoint, float zDistance)
+{
+    vec3 direction = endPoint - startPoint;
+    vec3 normal = vec3(0.0, 0.0, -1.0);
+
+    float t = (zDistance - dot(normal, startPoint)) / dot(normal, direction);
+    return startPoint + t * direction;
+}
+vec3 screenToView(vec2 screenCoord)
+{
+    vec4 ndc = vec4(screenCoord / screenRes * 2.0 - 1.0, -1.0, 1.0);
+
+    vec4 viewCoord = inverseProjectionMatrix * ndc;
+    viewCoord /= viewCoord.w;
+    return viewCoord.xyz;
+}
+
+void main()
+{
+    uint tileIndex = gl_WorkGroupID.x + (gl_WorkGroupID.y * uint(gridSize.x)) + (gl_WorkGroupID.z * uint(gridSize.x) * uint(gridSize.y));
+    vec2 tileSize = vec2(ivec2(screenRes) / ivec2(gridSize.xy));
+
+    vec2 minTile_screenspace = vec2(gl_WorkGroupID.xy) * tileSize;
+    vec2 maxTile_screenspace = vec2(gl_WorkGroupID.xy + 1u) * tileSize;
+
+    vec3 minTile = screenToView(minTile_screenspace);
+    vec3 maxTile = screenToView(maxTile_screenspace);
+
+    float planeNear = near * pow(clusterFar / near, float(gl_WorkGroupID.z) / gridSize.z);
+    float planeFar = near * pow(clusterFar / near, float(gl_WorkGroupID.z + 1u) / gridSize.z);
+
+    vec3 minPointNear = lineIntersectionWithZPlane(vec3(0, 0, 0), minTile, planeNear);
+    vec3 minPointFar = lineIntersectionWithZPlane(vec3(0, 0, 0), minTile, planeFar);
+    vec3 maxPointNear = lineIntersectionWithZPlane(vec3(0, 0, 0), maxTile, planeNear);
+    vec3 maxPointFar = lineIntersectionWithZPlane(vec3(0, 0, 0), maxTile, planeFar);
+
+    clusters[tileIndex].minPoint = vec4(min(minPointNear, minPointFar), 0.0);
+    clusters[tileIndex].maxPoint = vec4(max(maxPointNear, maxPointFar), 0.0);
+}
+
+#pragma GLES
diff --git a/files/shaders/gles/core/lighting/cull.comp b/files/shaders/gles/core/lighting/cull.comp
index e69de29bb2..761b7f56ad 100755
--- a/files/shaders/gles/core/lighting/cull.comp
+++ b/files/shaders/gles/core/lighting/cull.comp
@@ -0,0 +1,83 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+//HEADER_END
+
+
+layout(local_size_x = @workGroupSize, local_size_y = 1, local_size_z = 1) in;
+
+#include "lib/light/bindings.glsl"
+
+shared Cluster g_cluster;
+
+shared uint g_Count;
+shared uint g_Offset;
+shared uint g_List[@maxLightsPerCluster];
+
+bool sphereAABBIntersection(vec3 center, float radius, vec3 aabbMin, vec3 aabbMax)
+{
+    vec3 closestPoint = clamp(center, aabbMin, aabbMax);
+    return dot(closestPoint - center, closestPoint - center) <= radius * radius;
+}
+
+bool testSphereAABB(int i, Cluster cluster)
+{
+    vec3 center = pointLight[i].position.xyz;
+    float radius = pointLight[i].radius;
+
+    vec3 aabbMin = cluster.minPoint.xyz;
+    vec3 aabbMax = cluster.maxPoint.xyz;
+
+    return sphereAABBIntersection(center, radius, aabbMin, aabbMax);
+}
+
+void main()
+{
+    if (gl_LocalInvocationIndex == 0u) {
+        g_Count = 0u;
+        g_cluster = clusters[gl_WorkGroupID.x];
+    }
+
+    barrier();
+
+    uint index = 0u;
+
+    for (uint i = gl_LocalInvocationIndex; i < uint(pointLight.length()); i += uint(@workGroupSize)) {
+        PointLight light = pointLight[i];
+
+        vec3 center = light.position.xyz;
+        float radius = light.radius;
+
+        vec3 aabbMin = g_cluster.minPoint.xyz;
+        vec3 aabbMax = g_cluster.maxPoint.xyz;
+
+        if (sphereAABBIntersection(center, radius, aabbMin, aabbMax)) {
+            index = atomicAdd(g_Count, 1u);
+
+            if (index >= uint(@maxLightsPerCluster)) break;
+
+            g_List[index] = i;
+        }
+    }
+
+    barrier();
+
+    if (gl_LocalInvocationIndex == 0u) {
+        g_Offset = atomicAdd(globalLightIndexCount, g_Count);
+        lightGrid[gl_WorkGroupID.x] = LightGrid(g_Offset, g_Count);
+    }
+
+    barrier();
+
+    for (uint i = gl_LocalInvocationIndex; i < g_Count; i += uint(@workGroupSize)) {
+        lightIndexList[g_Offset + i] = g_List[i];
+    }
+}
+
+#pragma GLES
diff --git a/files/shaders/gles/core/ripples_blobber.comp b/files/shaders/gles/core/ripples_blobber.comp
index e69de29bb2..3358f7cf10 100755
--- a/files/shaders/gles/core/ripples_blobber.comp
+++ b/files/shaders/gles/core/ripples_blobber.comp
@@ -0,0 +1,43 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+//HEADER_END
+
+
+layout (binding = 0, rgba16f) restrict writeonly uniform image2D imageOut;
+layout (binding = 1, rgba16f) restrict readonly uniform image2D imageIn;
+
+layout (local_size_x=16, local_size_y=16) in;
+
+#define MAX_POSITIONS 100
+uniform vec3 positions[MAX_POSITIONS];
+uniform int positionCount;
+
+uniform float osg_SimulationTime;
+uniform vec2 offset;
+
+#include "lib/water/ripples.glsl"
+
+void main()
+{
+    ivec2 texel = ivec2(gl_GlobalInvocationID.xy + uvec2(offset));
+
+    vec4 color = imageLoad(imageIn, texel);
+    float wavesizeMultiplier = getTemporalWaveSizeMultiplier(osg_SimulationTime);
+    for (int i = 0; i < positionCount; ++i)
+    {
+        float wavesize = wavesizeMultiplier * positions[i].z;
+        float displace = clamp(0.2 * abs(length((positions[i].xy + offset) - vec2(gl_GlobalInvocationID.xy)) / wavesize - 1.0) + 0.8, 0.0, 1.0);
+        color.rg = mix(vec2(-1.0), color.rg, displace);
+    }
+
+    imageStore(imageOut, ivec2(gl_GlobalInvocationID.xy), color);
+}
+
+#pragma GLES
diff --git a/files/shaders/gles/core/ripples_simulate.comp b/files/shaders/gles/core/ripples_simulate.comp
index e69de29bb2..cc85ed48cd 100755
--- a/files/shaders/gles/core/ripples_simulate.comp
+++ b/files/shaders/gles/core/ripples_simulate.comp
@@ -0,0 +1,43 @@
+#version 320 es
+#extension GL_EXT_clip_cull_distance : enable
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+precision highp sampler3D;
+precision highp sampler2DShadow;
+precision highp sampler2DArray;
+precision highp image2D;
+//HEADER_END
+
+
+layout (binding = 0, rgba16f) restrict writeonly uniform image2D imageOut;
+layout (binding = 1, rgba16f) restrict readonly uniform image2D imageIn;
+
+layout (local_size_x=16, local_size_y=16) in;
+
+#include "lib/water/ripples.glsl"
+
+void main()
+{
+    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
+
+    vec4 n = vec4(
+        imageLoad(imageIn, texel + ivec2(1, 0)).r,
+        imageLoad(imageIn, texel + ivec2(-1, 0)).r,
+        imageLoad(imageIn, texel + ivec2(0, 1)).r,
+        imageLoad(imageIn, texel + ivec2(0, -1)).r
+    );
+
+    vec4 n2 = vec4(
+        imageLoad(imageIn, texel + ivec2(2, 0)).r,
+        imageLoad(imageIn, texel + ivec2(-2, 0)).r,
+        imageLoad(imageIn, texel + ivec2(0, 2)).r,
+        imageLoad(imageIn, texel + ivec2(0, -2)).r
+    );
+
+    vec4 color = imageLoad(imageIn, texel);
+
+    imageStore(imageOut, texel, applySprings(color, n, n2));
+}
+
