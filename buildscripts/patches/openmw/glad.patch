+
+GLADapiproc loadSystemGles(const char* name) 
+{
+    static void* lib = dlopen((getenv("OSG_USE_ANGLE") != nullptr) ? "libGLESv2_angle.so" : "libGLESv3.so", RTLD_NOW); 
+    return lib != nullptr ? reinterpret_cast<GLADapiproc>(dlsym(lib, name)) : nullptr;
+}
+
+void loadGladWithoutContext()
+{
+    static bool done = false;
+    if (!done)
+    {
+        done = true;
+        gladLoadGLES2(loadSystemGles);
+    }
+}
+
+
 bool OMW::Engine::createVulkanWindow(std::uint32_t flags, int posX, int posY, Settings::RendererEntry entry)
 {
 #ifdef OPENMW_USE_VULKAN
+    loadGladWithoutContext();
+
     const int width = Settings::video().mResolutionX;
     const int height = Settings::video().mResolutionY;
     const bool ownsWindow = mWindow == nullptr;
